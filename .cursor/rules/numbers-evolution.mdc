### Inline Comments

```elixir
def run_simulation(strategy, draw, opts) do
  # Initialize simulation state with timeout and attempt limits
  state = %{
    strategy: strategy,
    target: draw,
    attempts: 0,
    max_attempts: Keyword.get(opts, :max_attempts, 1_000_000),
    timeout_ms: Keyword.get(opts, :timeout_ms, 300_000),
    start_time: System.monotonic_time(:millisecond)
  }

  # Run attempts until match found, timeout, or max attempts reached
  # We use a recursive approach instead of Enum.reduce_while for better performance
  # in tight loops (millions of iterations)
  do_run_simulation(state)
end

defp do_run_simulation(state) do
  cond do
    # Check limits first to avoid unnecessary generation
    state.attempts >= state.max_attempts ->
      {:error, :max_attempts, state.attempts}

    timeout?(state) ->
      {:error, :timeout, state.attempts}

    true ->
      # Generate and check numbers
      # NOTE: This is the hot path - any optimization here impacts overall performance significantly
      numbers = generate_numbers(state.strategy)

      if match_grade_1?(numbers, state.target) do
        elapsed = System.monotonic_time(:millisecond) - state.start_time
        {:ok, %{numbers: numbers, attempts: state.attempts + 1, elapsed_ms: elapsed}}
      else
        # Tail-recursive call to avoid stack growth
        do_run_simulation(%{state | attempts: state.attempts + 1})
      end
  end
end
```

