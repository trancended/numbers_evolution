### Background Jobs with Oban

```elixir
defmodule NumbersEvolution.Workers.SimulationWorker do
  use Oban.Worker, queue: :simulations, max_attempts: 3

  @impl Oban.Worker
  def perform(%Oban.Job{args: %{"strategy_id" => strategy_id, "draw_id" => draw_id}}) do
    strategy = Strategies.get_strategy!(strategy_id)
    draw = Draws.get_draw!(draw_id)

    case Simulations.run(strategy, draw) do
      {:ok, result} ->
        Simulations.save_result(strategy, draw, result)
        :ok

      {:error, reason} ->
        {:error, reason}
    end
  end
end

# Enqueue job
%{strategy_id: strategy.id, draw_id: draw.id}
|> NumbersEvolution.Workers.SimulationWorker.new()
|> Oban.insert()
```

### Caching AI Responses

```elixir
def generate_strategy_with_cache(user, prompt) do
  cache_key = generate_cache_key(prompt)

  case get_from_cache(cache_key) do
    {:ok, cached_attrs} ->
      Logger.info("Using cached AI response for prompt")
      {:ok, cached_attrs}

    :miss ->
      case AIClient.generate_strategy(user, prompt) do
        {:ok, attrs} = result ->
          put_in_cache(cache_key, attrs, ttl: :timer.hours(24))
          result

        error ->
          error
      end
  end
end

defp generate_cache_key(prompt) do
  normalized = prompt |> String.downcase() |> String.trim()
  :crypto.hash(:sha256, normalized) |> Base.encode16()
end
```

