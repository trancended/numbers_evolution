## Data Modeling with Ecto

### Schema Design

```elixir
defmodule NumbersEvolution.Strategies.Strategy do
  use Ecto.Schema
  import Ecto.Changeset

  @type t :: %__MODULE__{}

  schema "strategies" do
    field :name, :string
    field :type, Ecto.Enum, values: [:random, :hot_numbers, :even_odd, :low_high, :balanced, :ai_generated]
    field :rules, :map  # JSONB in PostgreSQL
    field :performance_score, :float
    field :ai_prompt, :string

    belongs_to :user, NumbersEvolution.Accounts.User
    has_many :simulations, NumbersEvolution.Simulations.Simulation

    timestamps()
  end

  @doc false
  def changeset(strategy, attrs) do
    strategy
    |> cast(attrs, [:name, :type, :rules, :ai_prompt])
    |> validate_required([:name, :type, :rules])
    |> validate_length(:name, min: 3, max: 100)
    |> validate_length(:ai_prompt, max: 500)
    |> validate_rules()
    |> assoc_constraint(:user)
  end

  defp validate_rules(changeset) do
    validate_change(changeset, :rules, fn :rules, rules ->
      case NumbersEvolution.Strategies.Validator.validate_rules(rules) do
        :ok -> []
        {:error, reason} -> [rules: reason]
      end
    end)
  end
end
```

### Query Patterns

```elixir
defmodule NumbersEvolution.Strategies do
  import Ecto.Query

  @doc """
  Lists all strategies for a user, ordered by performance.
  """
  def list_strategies(user) do
    from(s in Strategy,
      where: s.user_id == ^user.id,
      order_by: [desc: s.performance_score],
      preload: [:simulations]
    )
    |> Repo.all()
  end

  @doc """
  Gets strategy with ranking stats.
  """
  def get_strategy_with_stats(user, strategy_id) do
    from(s in Strategy,
      where: s.id == ^strategy_id and s.user_id == ^user.id,
      left_join: sim in assoc(s, :simulations),
      group_by: s.id,
      select: %{
        strategy: s,
        total_simulations: count(sim.id),
        avg_attempts: avg(sim.attempts_count),
        median_attempts: fragment("percentile_cont(0.5) WITHIN GROUP (ORDER BY ?)", sim.attempts_count),
        success_rate: fragment("COUNT(CASE WHEN ? = 'success' THEN 1 END)::float / COUNT(*)", sim.status)
      }
    )
    |> Repo.one()
  end

  @doc """
  Top performing strategies (scoped to user).
  """
  def top_strategies(user, limit \\ 10) do
    from(s in Strategy,
      where: s.user_id == ^user.id,
      order_by: [asc: s.performance_score],
      limit: ^limit
    )
    |> Repo.all()
  end
end
```

### Avoiding N+1 Queries

```elixir
# BAD - N+1 query
strategies = Strategies.list_strategies(user)
Enum.each(strategies, fn strategy ->
  simulations = Repo.all(assoc(strategy, :simulations))
  # ...
end)

# GOOD - preload
strategies =
  Strategies.list_strategies(user)
  |> Repo.preload(:simulations)

# GOOD - join with aggregate
from(s in Strategy,
  left_join: sim in assoc(s, :simulations),
  where: s.user_id == ^user.id,
  group_by: s.id,
  select: {s, count(sim.id)}
)
```

