## Testing Strategies

### Test Structure

```elixir
defmodule NumbersEvolution.StrategiesTest do
  use NumbersEvolution.DataCase, async: true

  alias NumbersEvolution.Strategies

  describe "create_strategy/2" do
    setup do
      user = user_fixture()
      %{user: user}
    end

    test "creates strategy with valid attributes", %{user: user} do
      attrs = %{
        name: "Test Strategy",
        type: :random,
        rules: %{"weights" => %{"random" => 1.0}}
      }

      assert {:ok, strategy} = Strategies.create_strategy(user, attrs)
      assert strategy.name == "Test Strategy"
      assert strategy.user_id == user.id
    end

    test "returns error with invalid rules", %{user: user} do
      attrs = %{
        name: "Invalid",
        type: :balanced,
        rules: %{"weights" => %{"random" => 0.5}}  # doesn't sum to 1.0
      }

      assert {:error, changeset} = Strategies.create_strategy(user, attrs)
      assert "must sum to 1.0" in errors_on(changeset).rules
    end
  end

  describe "generate_numbers/1" do
    test "generates 5 main numbers and 2 euro numbers" do
      strategy = strategy_fixture(type: :random)

      assert {:ok, %{main: main, euro: euro}} = Strategies.generate_numbers(strategy)
      assert length(main) == 5
      assert length(euro) == 2
      assert Enum.all?(main, &(&1 in 1..50))
      assert Enum.all?(euro, &(&1 in 1..12))
    end

    test "hot numbers strategy favors frequent numbers" do
      strategy = strategy_fixture(type: :hot_numbers, rules: %{
        "weights" => %{"hot" => 0.8, "random" => 0.2}
      })

      # Run 100 times and check distribution
      results =
        for _ <- 1..100 do
          {:ok, %{main: main}} = Strategies.generate_numbers(strategy)
          main
        end
        |> List.flatten()
        |> Enum.frequencies()

      # Hot numbers should appear more frequently
      hot_numbers = Draw.analyze_hot_numbers(100)
      top_hot = Enum.take(hot_numbers, 5) |> Enum.map(& &1.number)

      hot_frequency =
        top_hot
        |> Enum.map(&Map.get(results, &1, 0))
        |> Enum.sum()

      assert hot_frequency > 100  # Should appear more than average
    end
  end
end
```

### Property-Based Testing with StreamData

```elixir
defmodule NumbersEvolution.Strategies.GeneratorPropertyTest do
  use NumbersEvolution.DataCase
  use ExUnitProperties

  property "generated numbers are always in valid range" do
    check all type <- member_of([:random, :hot_numbers, :even_odd, :low_high, :balanced]),
              rules <- strategy_rules_generator(type),
              max_runs: 100 do
      strategy = strategy_fixture(type: type, rules: rules)
      {:ok, %{main: main, euro: euro}} = Strategies.Generator.generate_numbers(strategy)

      assert length(main) == 5
      assert length(euro) == 2
      assert Enum.all?(main, &(&1 in 1..50))
      assert Enum.all?(euro, &(&1 in 1..12))
      assert length(Enum.uniq(main)) == 5
      assert length(Enum.uniq(euro)) == 2
    end
  end

  defp strategy_rules_generator(:random) do
    constant(%{"weights" => %{"random" => 1.0}})
  end

  defp strategy_rules_generator(:balanced) do
    # Generate weights that sum to 1.0
    weights =
      StreamData.bind(StreamData.list_of(StreamData.float(min: 0.0, max: 1.0), length: 3), fn floats ->
        sum = Enum.sum(floats)
        normalized = Enum.map(floats, &(&1 / sum))
        [hot, cold, random] = normalized

        constant(%{
          "weights" => %{
            "hot" => hot,
            "cold" => cold,
            "random" => random
          }
        })
      end)

    weights
  end
end
```

