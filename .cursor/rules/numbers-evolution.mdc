### Draw Analysis Helpers

```elixir
# Get hot numbers from recent draws
def analyze_hot_numbers(limit \\ 100) do
  draws = Draws.recent(limit)

  numbers =
    draws
    |> Enum.flat_map(& &1.main_numbers)
    |> Enum.frequencies()
    |> Enum.sort_by(fn {_num, freq} -> -freq end)
    |> Enum.map(fn {num, freq} -> %{number: num, frequency: freq} end)

  numbers
end

# Analyze even/odd distribution
def analyze_even_odd_distribution(limit \\ 100) do
  draws = Draws.recent(limit)

  draws
  |> Enum.map(fn draw ->
    even_count = Enum.count(draw.main_numbers, &(rem(&1, 2) == 0))
    {even_count, 5 - even_count}
  end)
  |> Enum.frequencies()
end
```

