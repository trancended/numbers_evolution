## Process Design for Simulations

### GenServer for Concurrent Simulations

```elixir
defmodule NumbersEvolution.Simulations.Runner do
  use GenServer
  require Logger

  @max_attempts 1_000_000
  @timeout_ms 300_000  # 5 minutes

  def start_link(opts) do
    GenServer.start_link(__MODULE__, opts)
  end

  @impl true
  def init(opts) do
    strategy = Keyword.fetch!(opts, :strategy)
    draw = Keyword.fetch!(opts, :draw)
    live_view_pid = Keyword.fetch!(opts, :live_view_pid)

    state = %{
      strategy: strategy,
      target: draw,
      attempts: 0,
      live_view_pid: live_view_pid,
      start_time: System.monotonic_time(:millisecond)
    }

    # Start simulation immediately
    send(self(), :run_attempt)

    {:ok, state}
  end

  @impl true
  def handle_info(:run_attempt, state) do
    cond do
      state.attempts >= @max_attempts ->
        finish_simulation(state, {:error, :max_attempts})

      timeout?(state) ->
        finish_simulation(state, {:error, :timeout})

      true ->
        run_single_attempt(state)
    end
  end

  defp run_single_attempt(state) do
    numbers = Strategies.Generator.generate_numbers(state.strategy)
    state = %{state | attempts: state.attempts + 1}

    # Send update every 1000 attempts
    if rem(state.attempts, 1000) == 0 do
      send(state.live_view_pid, {:simulation_update, %{attempts: state.attempts}})
    end

    if match_grade_1?(numbers, state.target) do
      finish_simulation(state, {:ok, numbers})
    else
      send(self(), :run_attempt)
      {:noreply, state}
    end
  end

  defp finish_simulation(state, result) do
    send(state.live_view_pid, {:simulation_complete, result, state.attempts})
    {:stop, :normal, state}
  end
end
```

### Supervision Strategy

```elixir
defmodule NumbersEvolution.Simulations.Supervisor do
  use DynamicSupervisor

  def start_link(init_arg) do
    DynamicSupervisor.start_link(__MODULE__, init_arg, name: __MODULE__)
  end

  @impl true
  def init(_init_arg) do
    DynamicSupervisor.init(strategy: :one_for_one)
  end

  def start_simulation(strategy, draw, opts) do
    child_spec = {
      NumbersEvolution.Simulations.Runner,
      [strategy: strategy, draw: draw] ++ opts
    }

    DynamicSupervisor.start_child(__MODULE__, child_spec)
  end
end
```

### Task.async for Multi-Simulations

```elixir
def run_multi_simulation(strategy, draw_ids, live_view_pid) do
  tasks =
    Enum.map(draw_ids, fn draw_id ->
      Task.async(fn ->
        draw = Draws.get_draw!(draw_id)
        run_single_simulation(strategy, draw, live_view_pid)
      end)
    end)

  # Wait for all with timeout
  results = Task.await_many(tasks, 360_000)  # 6 minutes total

  aggregate_results(results)
end
```

