## AI Integration Best Practices

### AI Client with Error Handling

```elixir
defmodule NumbersEvolution.Strategies.AIClient do
  @moduledoc """
  Client for OpenAI/Claude API to generate strategies.
  Includes rate limiting, error handling, and fallbacks.
  """

  require Logger

  @max_retries 3
  @timeout 30_000
  @rate_limit_per_day 5

  @spec generate_strategy(User.t(), String.t()) ::
          {:ok, Strategy.t()} | {:error, :rate_limit | :ai_error | :invalid_response}
  def generate_strategy(user, prompt) do
    with :ok <- check_rate_limit(user),
         :ok <- validate_prompt(prompt),
         {:ok, ai_response} <- call_ai_api(prompt),
         {:ok, rules} <- parse_ai_response(ai_response),
         :ok <- validate_rules(rules) do
      {:ok, %{
        name: generate_name(rules),
        type: :ai_generated,
        rules: rules,
        ai_prompt: truncate_prompt(prompt)
      }}
    else
      {:error, reason} = error ->
        Logger.warning("AI strategy generation failed: #{inspect(reason)}")
        error
    end
  end

  defp check_rate_limit(user) do
    count = count_todays_ai_generations(user)

    if count >= @rate_limit_per_day do
      {:error, :rate_limit}
    else
      :ok
    end
  end

  defp validate_prompt(prompt) when byte_size(prompt) > 500 do
    {:error, :prompt_too_long}
  end
  defp validate_prompt(_prompt), do: :ok

  defp call_ai_api(prompt, retries \\ 0) do
    system_prompt = build_system_prompt()
    user_prompt = build_user_prompt(prompt)

    case http_client().post(api_url(), %{
      model: model_name(),
      messages: [
        %{role: "system", content: system_prompt},
        %{role: "user", content: user_prompt}
      ],
      temperature: 0.7
    }, headers: auth_headers(), timeout: @timeout) do
      {:ok, %{status: 200, body: body}} ->
        {:ok, body}

      {:ok, %{status: 429}} when retries < @max_retries ->
        # Rate limited, retry with backoff
        Process.sleep(:math.pow(2, retries) * 1000)
        call_ai_api(prompt, retries + 1)

      {:error, reason} ->
        {:error, :ai_error}
    end
  end

  defp parse_ai_response(response) do
    # AI should return JSON with strategy rules
    case Jason.decode(response) do
      {:ok, %{"weights" => _weights} = rules} ->
        {:ok, rules}

      _ ->
        {:error, :invalid_response}
    end
  rescue
    _ -> {:error, :invalid_response}
  end

  defp validate_rules(rules) do
    Strategies.Validator.validate_rules(rules)
  end

  # Inject HTTP client for testing
  defp http_client do
    Application.get_env(:numbers_evolution, :http_client, Req)
  end
end
```

### Rate Limiting

```elixir
defmodule NumbersEvolution.Strategies.RateLimiter do
  use GenServer

  @limit 5
  @window_ms 86_400_000  # 24 hours

  def check_limit(user_id) do
    GenServer.call(__MODULE__, {:check, user_id})
  end

  def increment(user_id) do
    GenServer.cast(__MODULE__, {:increment, user_id})
  end

  @impl true
  def handle_call({:check, user_id}, _from, state) do
    count = get_count(state, user_id)
    reply = if count >= @limit, do: {:error, :rate_limit}, else: :ok
    {:reply, reply, state}
  end

  @impl true
  def handle_cast({:increment, user_id}, state) do
    new_state = increment_count(state, user_id)
    {:noreply, new_state}
  end
end
```

